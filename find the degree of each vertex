class Solution {
    public int[] findDegrees(int[][] matrix) {
        int n = matrix.length;
        int[] degrees = new int[n];
        
        for (int i = 0; i < n; i++) {
            int degree = 0;
            for (int j = 0; j < matrix[i].length; j++) {
                if (matrix[i][j] != 0) {
                    degree++;
                }
            }
            degrees[i] = degree;
        }
        
        return degrees;
    }
}
