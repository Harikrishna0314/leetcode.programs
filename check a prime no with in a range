public class Main {
    public static void main(String[] args) {
        int start = 10;
        int end = 30;

        for (int n = start; n <= end; n++) {

            boolean isPrime = true;

            if (n <= 1) {
                isPrime = false;
            }

            for (int i = 2; i * i <= n; i++) {
                if (n % i == 0) {
                    isPrime = false;
                    break;
                }
            }

            if (isPrime) {
                System.out.print(n + " ");
            }
        }
    }
}
