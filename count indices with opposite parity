class Solution {
    public int[] countOppositeParity(int[] nums) {
        int n = nums.length;
        int[] result = new int[n];
        int evenCount = 0;
        int oddCount = 0;

        for (int i = n - 1; i >= 0; i--) {
            if ((nums[i] & 1) == 0) {
                result[i] = oddCount;
                evenCount++;
            } else {
                result[i] = evenCount;
                oddCount++;
            }
        }

        return result;
    }
}
